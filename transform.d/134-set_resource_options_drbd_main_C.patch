From db6e8c2780c2044617c00913846a22fec91ec454 Mon Sep 17 00:00:00 2001
From: Johannes Thoma <johannes@johannesthoma.com>
Date: Fri, 6 Mar 2020 18:22:16 +0100
Subject: [PATCH 4/7] drbd_main: set_resource_options without CPU mask handling.

---
 drbd/drbd_main.c | 43 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/drbd/drbd_main.c b/drbd/drbd_main.c
index 9a4d05c1d..e12f90be0 100644
--- a/drbd/drbd_main.c
+++ b/drbd/drbd_main.c
@@ -3283,6 +3283,7 @@ static void wake_all_device_misc(struct drbd_resource *resource)
 
 int set_resource_options(struct drbd_resource *resource, struct res_opts *res_opts)
 {
+#if 0
 	struct drbd_connection *connection;
 	cpumask_var_t new_cpu_mask;
 	int err;
@@ -3374,7 +3375,49 @@ int set_resource_options(struct drbd_resource *resource, struct res_opts *res_op
 fail:
 	free_cpumask_var(new_cpu_mask);
 	return err;
+#else
+	/* No CPU mask handling on Windows, but keep the quorum logic */
+	bool wake_device_misc = false;
+	bool force_state_recalc = false;
+	KIRQL irq_flags;
+	struct res_opts *old_opts = &resource->res_opts;
+
+	if (res_opts->nr_requests < DRBD_NR_REQUESTS_MIN)
+		res_opts->nr_requests = DRBD_NR_REQUESTS_MIN;
+
+	if (old_opts->quorum != res_opts->quorum ||
+	    old_opts->on_no_quorum != res_opts->on_no_quorum)
+		force_state_recalc = true;
+
+	if (resource->susp_quorum[NOW] &&
+	    (res_opts->quorum != old_opts->quorum ||
+	     (old_opts->on_no_quorum == ONQ_SUSPEND_IO && res_opts->on_no_quorum == ONQ_IO_ERROR))) {
+		struct drbd_device *device;
+		int vnr;
+
+		wake_device_misc = true;
 
+		idr_for_each_entry(&resource->devices, device, vnr) {
+			if (test_and_clear_bit(NEW_CUR_UUID, &device->flags))
+				drbd_uuid_new_current(device, false);
+		}
+	}
+
+	if (resource->res_opts.nr_requests < res_opts->nr_requests)
+		wake_device_misc = true;
+
+	resource->res_opts = *res_opts;
+
+	if (force_state_recalc) {
+		begin_state_change(resource, &irq_flags, CS_VERBOSE | CS_FORCE_RECALC);
+		end_state_change(resource, &irq_flags);
+	}
+
+	if (wake_device_misc)
+		wake_all_device_misc(resource);
+
+	return 0;
+#endif
 }
 
 struct drbd_resource *drbd_create_resource(const char *name,
